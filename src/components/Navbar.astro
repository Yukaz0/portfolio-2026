---
import { DEFAULT_LOCALE, type Locale } from '../i18n/config';
import { t } from '../i18n/ui';
import ThemeToggle from './ThemeToggle.astro';
import LangSwitcher from './LangSwitcher.astro';
import profile from '../data/profile.json';

interface Props { locale: Locale }
const { locale } = Astro.props;
const anchors = [
  { id: 'about', href: '#about', key: 'nav_about' },
  { id: 'work', href: '#work', key: 'nav_work' },
  { id: 'projects', href: '#projects', key: 'nav_projects' },
  { id: 'contact', href: '#contact', key: 'nav_contact' },
] as const;

// Section anchor hanya ada di homepage. Dari halaman lain (mis. case study),
// anchor harus menunjuk ke homepage locale yang sama, bukan hash mati.
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const homePath = `${base}${locale === DEFAULT_LOCALE ? '' : `/${locale}`}/`;
const norm = (p: string) => p.replace(/\/+$/, '') || '/';
const onHome = norm(Astro.url.pathname) === norm(homePath);
const anchorHref = (hash: string) => (onHome ? hash : `${homePath}${hash}`);
---
<header class="sticky top-0 z-40 bg-background border-b border-hairline">
  <div class="mx-auto max-w-[1280px] px-6 h-14 flex items-center justify-between gap-4">
    <a href="#main" class="font-display text-xl tracking-tight text-foreground no-underline hover:text-body transition-opacity duration-150 min-h-11 inline-flex items-center">Ikbal.</a>
    <nav aria-label="main" class="hidden md:flex items-center gap-1">
      {anchors.map((a) => (
        <a href={anchorHref(a.href)} data-nav-link={a.id} class="font-display text-xs tracking-[1px] px-3 min-h-11 inline-flex items-center text-body no-underline hover:text-foreground transition-colors duration-150"><span class="nav-marker" aria-hidden="true">/</span>{t(locale, a.key)}</a>
      ))}
      <a href={profile.github} rel="noopener" class="font-display text-xs tracking-[1px] px-3 min-h-11 inline-flex items-center text-body no-underline hover:text-foreground transition-colors duration-150">GitHub</a>
      <a href={profile.linkedin} rel="noopener" class="font-display text-xs tracking-[1px] px-3 min-h-11 inline-flex items-center text-body no-underline hover:text-foreground transition-colors duration-150">LinkedIn</a>
    </nav>
    <div class="flex items-center gap-2">
      <LangSwitcher locale={locale} />
      <ThemeToggle locale={locale} />
    </div>
  </div>
  {/* mobile nav: baris kedua, anchor internal saja (link eksternal ada di hero + contact).
      px-3 + 4 anchor = 293px pada text-xs, sehingga muat di 320px tanpa scroll. */}
  <nav aria-label="mobile" class="md:hidden border-t border-hairline flex overflow-x-auto">
    {anchors.map((a) => (
      <a href={anchorHref(a.href)} data-nav-link={a.id} class="flex-1 shrink-0 font-display text-xs tracking-[1px] px-3 min-h-11 inline-flex items-center justify-center text-body no-underline hover:text-foreground">{t(locale, a.key)}</a>
    ))}
  </nav>
</header>
