---
import type { Locale } from '../i18n/config';
import { t } from '../i18n/ui';
interface Props { locale: Locale }
const { locale } = Astro.props;
---
<button
  id="theme-toggle"
  type="button"
  aria-pressed="false"
  data-label-light={t(locale, 'theme_light')}
  data-label-dark={t(locale, 'theme_dark')}
  data-switch-light={t(locale, 'theme_switch_light')}
  data-switch-dark={t(locale, 'theme_switch_dark')}
  aria-label={t(locale, 'theme_switch_light')}
  class="font-display text-[11px] tracking-[1px] h-11 min-w-[72px] px-4 border border-hairline bg-transparent text-body hover:border-hairline-strong hover:text-foreground transition-colors duration-150 cursor-pointer"
>
  <span class="theme-label">LIGHT</span>
</button>
<script>
  (() => {
    const btn = document.getElementById('theme-toggle');
    if (!btn) return;
    const label = btn.querySelector('.theme-label');
    const light = btn.dataset.labelLight || 'LIGHT';
    const dark = btn.dataset.labelDark || 'DARK';
    const switchLight = btn.dataset.switchLight || 'Switch to light theme';
    const switchDark = btn.dataset.switchDark || 'Switch to dark theme';
    const render = () => {
      const theme = document.documentElement.dataset.theme === 'light' ? 'light' : 'dark';
      btn.setAttribute('aria-pressed', String(theme === 'light'));
      const nextTheme = theme === 'light' ? 'dark' : 'light';
      if (label) label.textContent = nextTheme === 'light' ? light : dark;
      btn.setAttribute('aria-label', nextTheme === 'light' ? switchLight : switchDark);
    };
    render();
    btn.addEventListener('click', () => {
      const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
      document.documentElement.dataset.theme = next;
      localStorage.setItem('theme', next);
      render();
    });
  })();
</script>
