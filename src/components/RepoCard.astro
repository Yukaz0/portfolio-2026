---
import { DEFAULT_LOCALE, type Locale } from '../i18n/config';
import { t } from '../i18n/ui';
import type { CuratedProject } from '../data/project-curation';

interface Props {
  repo: { name: string; language: string | null; url: string };
  curation: CuratedProject;
  locale: Locale;
  featured?: boolean;
  /** Urutan dalam grup stagger: kartu anak [data-stagger] memakai ini sebagai --index. */
  index?: number;
}
const { repo, curation, locale, featured = false, index = 0 } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const prefix = `${base}${locale === DEFAULT_LOCALE ? '' : `/${locale}`}`;
const caseStudyHref = curation.caseStudySlug
  ? `${prefix}/projects/${curation.caseStudySlug}/`
  : undefined;

// Arrow dipakai hanya di sini, bukan di semua tombol: fungsinya menandai kontrol
// yang membawa ke halaman lain (R-08). Tanpa overlay stretched-link, karena dua
// link nyata tidak boleh saling menutupi.
const linkClass = 'project-link font-display text-xs tracking-[1.4px] text-foreground no-underline border border-hairline px-4 min-h-11 min-w-11 inline-flex items-center hover:bg-surface hover:border-hairline-strong transition-colors duration-150';
---
<article
  class:list={[
    'project-card border border-hairline bg-card p-6 flex flex-col gap-md hover:border-hairline-strong transition-colors duration-150',
    featured && 'sm:p-8 gap-lg',
  ]}
  style={`--index: ${index}`}
>
  {featured && <p class="font-display text-xs tracking-[1.4px] uppercase text-mute m-0">{t(locale, 'repo_featured')}</p>}
  <div class="flex items-baseline justify-between gap-lg">
    <h3 class:list={['font-display text-foreground m-0', featured ? 'text-[24px] sm:text-[30px] leading-tight' : 'text-lg']}>
      {repo.name}
    </h3>
    <span class="lang-label font-display text-xs tracking-[1px] text-mute shrink-0">{repo.language ?? '-'}</span>
  </div>
  <p class="text-sm leading-[1.5] text-body m-0">
    {curation.summary[locale]}
  </p>
  {featured && curation.proofPoints?.[locale] && (
    <div class="border-t border-hairline pt-lg">
      <p class="font-display text-xs tracking-[1.4px] uppercase text-mute m-0 mb-sm">{t(locale, 'repo_proof')}</p>
      <ul class="m-0 p-0 list-none grid gap-xs">
        {curation.proofPoints[locale].map((point) => (
          <li class="text-sm leading-[1.5] text-body pl-4 relative before:content-[''] before:absolute before:left-0 before:top-[0.6em] before:w-1.5 before:h-1.5 before:bg-stone">{point}</li>
        ))}
      </ul>
    </div>
  )}
  <slot />
  <div class="mt-auto pt-sm flex flex-wrap gap-md">
    {caseStudyHref && (
      <a href={caseStudyHref} class={linkClass}>
        <span>{t(locale, 'repo_case_study')}</span>
        <span class="link-arrow" aria-hidden="true">&#8594;</span>
      </a>
    )}
    <a href={repo.url} rel="noopener" class={linkClass}>
      <span>{t(locale, 'repo_source')}</span>
      <span class="link-arrow" aria-hidden="true">&#8594;</span>
    </a>
  </div>
</article>
