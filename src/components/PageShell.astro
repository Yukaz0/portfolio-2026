---
import { DEFAULT_LOCALE, type Locale } from '../i18n/config';
import { t } from '../i18n/ui';
import profile from '../data/profile.json';
import repos from '../data/public-repos.json';
import experience from '../data/experience.json';
import { CURATED_PROJECTS, type CuratedProject } from '../data/project-curation';
import RepoCard from './RepoCard.astro';
import OrgStats from './OrgStats.astro';
import ProjectFlow from './Motion/ProjectFlow.astro';

interface Props { locale: Locale }
const { locale } = Astro.props;

type Repo = (typeof repos)[number];
const byName = new Map<string, Repo>(repos.map((r) => [r.name, r]));

// Urutan tampil mengikuti CURATED_PROJECTS. Repo yang tidak punya entri kurasi
// tidak pernah dirender, sehingga deskripsi mentah GitHub tidak bisa bocor ke UI.
const curated = CURATED_PROJECTS
  .map((curation) => ({ curation, repo: byName.get(curation.repoName) }))
  .filter((x): x is { curation: CuratedProject; repo: Repo } => Boolean(x.repo));
const featured = curated.find((x) => x.curation.featured);
const rest = curated.filter((x) => !x.curation.featured);

const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const prefix = `${base}${locale === DEFAULT_LOCALE ? '' : `/${locale}`}`;
// CV adalah satu berkas di root public/, jadi tidak diberi prefix locale.
const resumeHref = `${base}${profile.resumeUrl}`;
const flagshipSlug = featured?.curation.caseStudySlug;
const flagshipHref = flagshipSlug ? `${prefix}/projects/${flagshipSlug}/` : undefined;
---
<!-- HERO -->
<!-- Entrance berurutan mengikuti urutan kepentingan recruiter. CSS murni tanpa
     JS: hero adalah elemen LCP dan tidak boleh menunggu script. -->
<section id="hero" class="mx-auto max-w-[1280px] px-6 pt-band-sm md:pt-band pb-section">
  <p data-hero-step style="--hero-delay: 0ms" class="font-display text-xs tracking-[1.4px] text-mute uppercase mb-lg">{t(locale, 'hero_greeting')}</p>
  <h1 data-hero-step style="--hero-delay: 50ms" class="font-display font-light text-foreground leading-tight text-[clamp(36px,9vw,72px)] m-0">{t(locale, 'hero_name')}</h1>
  <p data-hero-step style="--hero-delay: 110ms" class="max-w-[640px] text-lg leading-[1.6] text-body mt-xxl">{t(locale, 'hero_line1')}</p>
  <p data-hero-step style="--hero-delay: 170ms" class="max-w-[640px] text-base leading-[1.5] text-mute mt-lg">{t(locale, 'hero_line2')}</p>
  <div data-hero-step style="--hero-delay: 230ms" class="flex flex-wrap gap-lg mt-xxl">
    <a href={resumeHref} download class="font-display text-sm tracking-[1.4px] h-11 px-8 inline-flex items-center bg-foreground text-on-primary no-underline hover:opacity-90 transition-opacity duration-150">{t(locale, 'cta_resume')}</a>
    {flagshipHref && (
      <a href={flagshipHref} class="font-display text-sm tracking-[1.4px] h-11 px-8 inline-flex items-center border border-hairline-strong text-foreground no-underline hover:bg-surface transition-colors duration-150">{t(locale, 'cta_flagship')}</a>
    )}
  </div>
  <ul data-hero-step style="--hero-delay: 270ms" class="m-0 p-0 list-none flex flex-wrap gap-x-xxl gap-y-sm mt-lg">
    <li>
      <a href={profile.github} rel="noopener" class="font-display text-xs tracking-[1.4px] min-h-11 inline-flex items-center text-body no-underline hover:text-foreground transition-colors duration-150">
        <span class="border-b border-hairline-strong pb-0.5">{t(locale, 'cta_github')}</span>
      </a>
    </li>
    <li>
      <a href={profile.linkedin} rel="noopener" class="font-display text-xs tracking-[1.4px] min-h-11 inline-flex items-center text-body no-underline hover:text-foreground transition-colors duration-150">
        <span class="border-b border-hairline-strong pb-0.5">{t(locale, 'cta_linkedin')}</span>
      </a>
    </li>
  </ul>
</section>

<!-- ABOUT: 60/40 asimetris -->
<section id="about" data-nav-section="about" class="mx-auto max-w-[1280px] px-6 py-section border-t border-hairline">
  <div class="grid grid-cols-1 md:grid-cols-[3fr_2fr] gap-xxxl">
    <div>
      <h2 data-reveal class="font-display font-light text-[32px] md:text-[48px] leading-tight m-0 mb-xxl">{t(locale, 'about_title')}</h2>
      <p data-reveal class="text-base leading-[1.5] text-body not-italic m-0 mb-lg">{t(locale, 'about_p1')}</p>
      <p data-reveal class="text-base leading-[1.5] text-body m-0 mb-lg">{t(locale, 'about_p2')}</p>
      <p data-reveal class="text-base leading-[1.5] text-mute m-0">{t(locale, 'about_p3')}</p>
    </div>
    <aside class="md:pt-[56px]">
      <div class="border border-hairline bg-card p-6">
        <h3 data-reveal class="font-display text-xs tracking-[1.4px] uppercase text-mute m-0 mb-lg">{t(locale, 'about_stack')}</h3>
        <ul data-stagger class="m-0 p-0 list-none flex flex-wrap gap-sm">
          {profile.stack.map((s, i) => (
            <li style={`--index: ${i}`} class="font-display text-xs text-foreground bg-surface border border-hairline px-2 py-1">{s}</li>
          ))}
        </ul>
        <h3 data-reveal="fade" class="font-display text-xs tracking-[1.4px] uppercase text-mute m-0 mb-lg mt-xl">{t(locale, 'about_edu')}</h3>
        <p data-reveal="fade" class="text-sm text-body m-0">{t(locale, 'about_edu_val')}</p>
        <h3 data-reveal="fade" class="font-display text-xs tracking-[1.4px] uppercase text-mute m-0 mb-lg mt-xl">{t(locale, 'about_loc')}</h3>
        <p data-reveal="fade" class="text-sm text-body m-0">{t(locale, 'about_loc_val')}</p>
      </div>
    </aside>
  </div>
</section>

<!-- WORK: timeline + agregat org -->
<section id="work" data-nav-section="work" class="mx-auto max-w-[1280px] px-6 py-section border-t border-hairline">
  <h2 data-reveal class="font-display font-light text-[32px] md:text-[48px] leading-tight m-0 mb-xxl">{t(locale, 'work_title')}</h2>
  <!-- garis digambar sekali dengan scaleY dari atas; posisi masuk berurutan 90ms -->
  <ol data-stagger class="timeline m-0 p-0 list-none ml-1">
    {experience.positions.map((p, i) => (
      <li style={`--index: ${i}`} class="relative pl-8 pb-xxl last:pb-0">
        <span class="absolute -left-[5px] top-2 h-[9px] w-[9px] bg-foreground" aria-hidden="true"></span>
        <p class="font-display text-xs tracking-[1px] text-mute m-0">{t(locale, p.whenKey as never)}</p>
        <h3 class="text-xl font-normal text-foreground mt-xs mb-xs">{t(locale, p.roleKey as never)}</h3>
        <p class="text-sm text-body m-0 mb-md">{t(locale, p.orgKey as never)} <span class="text-stone">·</span> {t(locale, p.typeKey as never)}</p>
        <ul class="m-0 p-0 list-none">
          {p.bulletKeys.map((b) => (
            <li class="text-sm leading-[1.5] text-body mb-sm before:content-[''] before:inline-block before:w-2 before:h-2 before:bg-stone before:mr-sm">
              {t(locale, b as never)}
            </li>
          ))}
        </ul>
      </li>
    ))}
  </ol>
  <div data-reveal class="mt-xxxl">
    <OrgStats locale={locale} />
  </div>
</section>

<!-- PROJECTS -->
<section id="projects" data-nav-section="projects" class="mx-auto max-w-[1280px] px-6 py-section border-t border-hairline">
  <h2 data-reveal class="font-display font-light text-[32px] md:text-[48px] leading-tight m-0 mb-lg">{t(locale, 'projects_title')}</h2>
  <p data-reveal class="text-base text-mute m-0 mb-xxl max-w-[640px]">{t(locale, 'projects_note')}</p>
  {featured && (
    <div data-reveal class="mb-xxxl">
      <RepoCard repo={featured.repo} curation={featured.curation} locale={locale} featured>
        {featured.curation.showFlow && <ProjectFlow locale={locale} />}
      </RepoCard>
    </div>
  )}
  <div data-stagger class="grid grid-cols-1 sm:grid-cols-2 gap-lg">
    {rest.map((x, i) => (
      <RepoCard repo={x.repo} curation={x.curation} locale={locale} index={i} />
    ))}
  </div>
</section>

<!-- CONTACT: teks link nyata, tanpa form -->
<section id="contact" data-nav-section="contact" class="mx-auto max-w-[1280px] px-6 py-section border-t border-hairline">
  <h2 data-reveal class="font-display font-light text-[32px] md:text-[48px] leading-tight m-0 mb-xxl">{t(locale, 'contact_title')}</h2>
  <p data-reveal class="text-base text-body max-w-[560px] m-0 mb-xxl">{t(locale, 'contact_line')}</p>
  <ul data-stagger class="m-0 p-0 list-none grid grid-cols-1 sm:grid-cols-3 gap-lg">
    <li>
      <a href={`mailto:${profile.email}`} class="font-display text-sm tracking-[1px] text-foreground no-underline border-b border-hairline-strong hover:bg-surface transition-colors duration-150 break-all min-h-11 inline-flex items-center">
        {profile.email}
      </a>
    </li>
    <li>
      <a href={profile.github} rel="noopener" class="font-display text-sm tracking-[1px] text-foreground no-underline border-b border-hairline-strong hover:bg-surface transition-colors duration-150 min-h-11 inline-flex items-center">
        github.com/Yukaz0
      </a>
    </li>
    <li>
      <a href={profile.linkedin} rel="noopener" class="font-display text-sm tracking-[1px] text-foreground no-underline border-b border-hairline-strong hover:bg-surface transition-colors duration-150 break-all min-h-11 inline-flex items-center">
        linkedin.com/in/muhammad-jafar-i-5b0062130
      </a>
    </li>
  </ul>
</section>
