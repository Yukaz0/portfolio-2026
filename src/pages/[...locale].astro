---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageShell from '../components/PageShell.astro';
import { t } from '../i18n/ui';
import { isLocale, DEFAULT_LOCALE, LOCALES, type Locale } from '../i18n/config';
import { getRelativeLocaleUrl } from 'astro:i18n';

export function getStaticPaths() {
  return LOCALES.filter((l) => l !== DEFAULT_LOCALE).map((l) => ({ params: { locale: l } }));
}

const param = Astro.params.locale ?? '';
if (!isLocale(param)) return Astro.rewrite(getRelativeLocaleUrl(DEFAULT_LOCALE, ''));
const locale: Locale = param;
---
<BaseLayout locale={locale} title={`${t(locale, 'hero_name')} - ${t(locale, 'hero_greeting')}`} description={t(locale, 'hero_line1')}>
  <PageShell locale={locale} />
</BaseLayout>
